# --- support form (server-side only: the form posts to a Server Action) ---
# The support project, which holds support_requests. SUPPORT_SUPABASE_URL
# falls back to NEXT_PUBLIC_SUPABASE_URL. The service-role key is NOT the
# Pix CMS key; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPPORT_SUPABASE_URL=
SUPPORT_SUPABASE_SERVICE_ROLE_KEY=

# --- /news pages (server-side only; read by server components and route handlers) ---
# Pixie CMS project. The service-role key is required because pix_posts has
# no anon read policy. Set these in the Vercel project (mark the key Sensitive)
# and in .env.local for local development. Do NOT prefix them with NEXT_PUBLIC_.
PIX_SUPABASE_URL=https://coggfnbqqyiqfsxvtaym.supabase.co
PIX_SUPABASE_SERVICE_ROLE_KEY=

# Optional escape hatch. The finished cards normally come from
# pix_posts.web_pages (copied to the public Supabase bucket by the CMS at
# publish). The app backend also keeps copies on the private bucket
# shortly-bucket.s3.ap-south-1.amazonaws.com; if a public CDN host is ever put
# in front of that bucket, name it here and those copies become usable too.
# Leave empty.
PIX_MEDIA_CDN=

# optional: canonical origin used in links, sitemaps and JSON-LD
# SITE_ORIGIN=https://www.dailymattr.com

# --- /news-studio, newsletter and unsubscribe (browser; public values — RLS guards the data) ---
# The News Studio Supabase project. Kept separate from the support project
# above. The same values are built in as defaults, so these only override them.
NEXT_PUBLIC_NEWS_STUDIO_SUPABASE_URL=https://ygxdrphajvrbjcaxhvcn.supabase.co
NEXT_PUBLIC_NEWS_STUDIO_SUPABASE_ANON_KEY=
NEXT_PUBLIC_NEWS_STUDIO_SUBSCRIBE_URL=https://ygxdrphajvrbjcaxhvcn.functions.supabase.co/subscribers
# --- /news-studio server-rendered SEO and sitemaps (same project) ---
NEWS_STUDIO_SUPABASE_URL=https://ygxdrphajvrbjcaxhvcn.supabase.co
NEWS_STUDIO_SUPABASE_ANON_KEY=
